# Direct dependencies of CrystalNexus: runtime plus test and maintenance tools,
# locked together in a single requirements.txt.
# Compile with:  pip-compile --strip-extras requirements.in -o requirements.txt
# When a Docker image is added, a runtime-only file (e.g. requirements-runtime.in)
# can be split out again from the "Runtime" section below.
# The lock (requirements.txt) is compiled on Windows / Python 3.12 with the
# CPU build of torch (the PyPI Windows wheel is CPU-only; no extra index needed).

# ===== Runtime =====

# Web layer
fastapi==0.143.0
uvicorn==0.54.0
python-multipart==0.0.32
jinja2==3.1.6
requests==2.34.2                      # startup script health checks

# Scientific stack
numpy==2.5.4
scipy==1.18.1
torch==2.14.1                         # CPU build on Windows; 2.9.1+ slows MACE ~1.5x but 2.9.0 has known advisories, so accepted
pymatgen==2026.9.24
pymatgen-analysis-defects==2026.3.20

# ML interatomic potentials
chgnet==0.4.2                         # requires torch>=2.4.0, numpy>=1.26
# MACE-MP-0 (medium); MIT licensed, weights downloaded to ~/.cache/mace on first use.
mace-torch==0.3.16
e3nn==0.4.4                           # pinned by mace-torch; do not upgrade independently

# ===== Test and maintenance tools =====
pytest
pytest-playwright                  # real-browser E2E tests (run `playwright install chromium`)
httpx
psutil
pip-tools
pip-audit
