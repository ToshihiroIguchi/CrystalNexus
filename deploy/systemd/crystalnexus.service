[Unit]
Description=CrystalNexus (FastAPI / uvicorn)
After=network.target

[Service]
Type=simple
User=crystalnexus
Group=crystalnexus
# The app resolves templates/, static/, sample_cif/ relative to the working
# directory and writes analytics.db next to analytics_db.py (inside the repo).
WorkingDirectory=/opt/crystalnexus/app
# Optional overrides (CRYSTALNEXUS_ANALYTICS_TOKEN, MAX_FILE_SIZE, RELAX_TIMEOUT_SECONDS, ...).
# Created by install.sh. HOME is /opt/crystalnexus so MACE weights go to ~/.cache/mace.
EnvironmentFile=-/etc/crystalnexus/crystalnexus.env
Environment=HOME=/opt/crystalnexus
Environment=PYTHONUNBUFFERED=1
# Keep the app on loopback; Nginx is the only public entry point.
# uvicorn trusts X-Forwarded-For from 127.0.0.1 by default, so per-IP rate limits
# and the analytics access check see the real client address.
ExecStart=/opt/crystalnexus/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5
# Relaxations can take minutes; give shutdown time to finish.
TimeoutStopSec=30

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/crystalnexus

[Install]
WantedBy=multi-user.target
