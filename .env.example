# CrystalNexus Configuration
#
# NOTE: main.py reads these via plain os.getenv() -- there is no
# python-dotenv/load_dotenv() call, so this file is NOT read automatically.
# Export these in your shell (or your process manager's env config) before
# starting the app; copying this to a literal ".env" has no effect unless
# your launcher sources it itself.

# Application Settings
CRYSTALNEXUS_APP_NAME=CrystalNexus
# Defaults to loopback if unset. This app has no authentication on any
# endpoint (including the analytics dashboard -- see
# CRYSTALNEXUS_ANALYTICS_TOKEN below), so setting this to 0.0.0.0 exposes
# every endpoint, unauthenticated, to your whole network. Only do this on
# a trusted LAN, and set CRYSTALNEXUS_ANALYTICS_TOKEN first.
#
# Preferred way to expose the app on your LAN: run
# `python start_crystalnexus.py --lan` instead of setting this var by hand --
# it auto-generates an analytics token, prints a security warning, and (on
# Windows) checks whether a firewall rule exists for you. Setting
# CRYSTALNEXUS_HOST=0.0.0.0 directly still works and triggers the identical
# protections (the launcher decides "LAN mode" from the resolved host, not
# from how it was set).
CRYSTALNEXUS_HOST=127.0.0.1
CRYSTALNEXUS_PORT=8080
CRYSTALNEXUS_DEBUG=False

# Directory Configuration
CRYSTALNEXUS_TEMPLATE_DIR=templates
CRYSTALNEXUS_STATIC_DIR=static
CRYSTALNEXUS_SAMPLE_CIF_DIR=sample_cif

# File Processing Limits
MAX_FILE_SIZE=52428800  # 50MB in bytes
MAX_SUPERCELL_DIM=10

# Memory Management Settings
SESSION_CLEANUP_HOURS=6
PERIODIC_CLEANUP_INTERVAL=1800  # 30 minutes in seconds
# How long to keep analytics_db rows (visitor IP/User-Agent history,
# uploaded filenames/formulas).
ANALYTICS_RETENTION_DAYS=90

# CHGNet Model Configuration
CHGNET_BATCH_SIZE=4
MAX_ATOMIC_NUMBER=94
MIN_SUPPORTED_ELEMENTS=50

# CHGNet Structure Relaxation Configuration
CHGNET_RELAX_OPTIMIZER=LBFGS  # LBFGS (default), FIRE, BFGS, or LBFGSLineSearch
MAX_RELAX_STEPS=500
MIN_RELAX_FMAX=0.01
MAX_RELAX_FMAX=1.0
MAX_RELAX_ATOMS=400
RELAX_TIMEOUT_SECONDS=600

# Supercell/session resource limits
# MAX_TOTAL_SITES caps the *product* of the supercell dimensions against
# the base structure's site count (MAX_SUPERCELL_DIM above only bounds
# each dimension independently).
MAX_TOTAL_SITES=20000
# Upper bound on concurrently-held sessions; least-recently-accessed
# sessions are evicted once this is reached.
MAX_SESSIONS=100

# Per-client-IP rate limit for POST /api/* requests (token bucket).
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=20

# Analytics dashboard access (/analytics, /api/analytics/*), which exposes
# visitor IP/User-Agent history and uploaded filenames/formulas. Three states:
#   - Unset (commented out, as below): dashboard is loopback-only; no token
#     needed from 127.0.0.1/localhost.
#   - Set to a non-empty value: that exact token is required from
#     everywhere, including localhost, via the X-Analytics-Token header or a
#     ?token= query parameter.
#   - Set to an empty string (CRYSTALNEXUS_ANALYTICS_TOKEN= with nothing
#     after the "=", uncommented): explicit opt-out -- the dashboard becomes
#     reachable from your whole LAN with no token at all.
#     `start_crystalnexus.py --lan` will print a warning if it sees this.
# `start_crystalnexus.py --lan` auto-generates and prints a fresh token on
# each run when this var is unset, so you normally don't need to set it by
# hand at all unless you want a token that stays stable across restarts.
# CRYSTALNEXUS_ANALYTICS_TOKEN=